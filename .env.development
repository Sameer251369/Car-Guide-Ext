# Local Vite server uses same-origin /api (see vite.config.js proxy).
# Default proxy target is local Django: http://127.0.0.1:8000
#
# To use the deployed Render backend from local frontend, uncomment:
# VITE_PROXY_TARGET=https://car-guide-engine.onrender.com
#
# Do not set VITE_API_URL here unless you want the browser to call the API
# directly (CORS) instead of going through the Vite proxy.
