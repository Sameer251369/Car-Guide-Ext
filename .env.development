# Local `npm run dev` — scenario A: local frontend + local Django
# Browser talks to http://localhost:3000/api (no CORS). Vite proxies to:
# VITE_PROXY_TARGET=http://127.0.0.1:8000
#
# Scenario B: local frontend + deployed Render (uncomment one):
# VITE_PROXY_TARGET=https://car-guide-engine.onrender.com
# or call Render directly (CORS; Django must allow http://localhost:3000):
# VITE_API_URL=https://car-guide-engine.onrender.com
