# Leave unset so the browser calls same-origin /api/v1 (Vite proxy or Vercel rewrites).
# Vercel: do not set VITE_API_URL unless Django CORS allows that frontend origin.
#
# Direct browser -> Render (requires CORS on Django):
# VITE_API_URL=https://car-guide-engine.onrender.com
#
# Local `npm run dev` proxy target (default is local Django):
# VITE_PROXY_TARGET=http://127.0.0.1:8000
# VITE_PROXY_TARGET=https://car-guide-engine.onrender.com
